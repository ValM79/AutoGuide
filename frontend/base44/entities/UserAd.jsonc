{
  "name": "UserAd",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subsection": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "mileage": {
      "type": "string"
    },
    "mileageUnit": {
      "type": "string"
    },
    "vehicleMake": {
      "type": "string"
    },
    "vehicleModel": {
      "type": "string"
    },
    "vehicleYear": {
      "type": "string"
    },
    "vehicleFuel": {
      "type": "string"
    },
    "vehicleTransmission": {
      "type": "string"
    },
    "bodyType": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "engineSize": {
      "type": "string"
    },
    "enginePower": {
      "type": "string"
    },
    "batteryRange": {
      "type": "string"
    },
    "batterySize": {
      "type": "string"
    },
    "numberOfSeats": {
      "type": "string"
    },
    "numberOfDoors": {
      "type": "string"
    },
    "previousOwners": {
      "type": "string"
    },
    "fullServiceHistory": {
      "type": "boolean"
    },
    "noAccidents": {
      "type": "boolean"
    },
    "roadTax": {
      "type": "string"
    },
    "nctExpiry": {
      "type": "string"
    },
    "taxExpiry": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fullName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "adType": {
      "type": "string"
    },
    "isTrader": {
      "type": "boolean"
    },
    "packageName": {
      "type": "string"
    },
    "listingDays": {
      "type": "number"
    },
    "spotlight": {
      "type": "boolean"
    },
    "paymentAmount": {
      "type": "number",
      "description": "Amount paid in cents (from Stripe)"
    },
    "receiptUrl": {
      "type": "string",
      "description": "Stripe receipt URL for the payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "pending"
      ],
      "default": "active"
    }
  },
  "required": [
    "title",
    "price",
    "subsection"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}