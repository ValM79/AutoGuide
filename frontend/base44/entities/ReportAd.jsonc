{
  "name": "ReportAd",
  "type": "object",
  "properties": {
    "ad_id": {
      "type": "string"
    },
    "ad_title": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "Misleading description or photos",
        "Prohibited item",
        "Fraud or scam",
        "Duplicate ad",
        "Spam",
        "Other"
      ]
    },
    "details": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved"
      ],
      "default": "pending"
    }
  },
  "required": [
    "ad_id",
    "reason"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}